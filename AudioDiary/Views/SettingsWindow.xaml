<Window
    x:Class="AudioDiary.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Налаштування запису"
    Width="400"
    Height="284"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="15">
        <StackPanel>
            <Label Content="Оберіть мікрофон (вкл. Вебкамеру):" FontWeight="Bold" />
            <ComboBox
                x:Name="CmbMicrophones"
                Height="30"
                Margin="0,5,0,20" />

            <Label Content="Чутливість мікрофона:" FontWeight="Bold" />
            <Slider
                x:Name="SliderSensitivity"
                Height="30"
                Margin="0,5,0,20"
                IsSnapToTickEnabled="True"
                Maximum="5"
                Minimum="1"
                TickFrequency="0.5" />
            <Button
                Height="40"
                Background="#FFA500"
                Click="BtnSaveSettings_Click"
                Content="Зберегти налаштування"
                FontSize="14"
                FontWeight="Bold"
                Foreground="White" />
        </StackPanel>
    </Grid>
</Window>